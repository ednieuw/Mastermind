IDI_SDIAPPLICATION ICON "applsdi.ico"


// Client Dialog
IDD_CLIENT DIALOG -32768, 38, 441, 315
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mastermind Version 1.0"
FONT 8, "MS Sans Serif"
{
 CONTROL "", PLATFORM, "BorShade", BSS_RGROUP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 276, 236, 112, 4
 CONTROL "1", IDC_BMP1, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 292, 92, 14, 15
 CONTROL "2", IDC_BMP2, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 320, 92, 29, 21
 CONTROL "3", IDC_BMP3, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 348, 92, 29, 21
 CONTROL "4", IDC_BMP4, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 292, 112, 29, 21
 CONTROL "5", IDC_BMP5, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 320, 112, 14, 15
 CONTROL "6", IDC_BMP6, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 348, 112, 29, 21
 CONTROL "7", IDC_BMP7, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 292, 132, 29, 21
 CONTROL "8", IDC_BMP8, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 320, 132, 29, 21
 CONTROL "9", IDC_BMP9, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 348, 132, 29, 21
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CENTER | WS_CHILD | WS_VISIBLE, 276, 84, 112, 136
 PUSHBUTTON "Start New Game", IDC_NEWGAME, 288, 16, 88, 36
 CONTROL "Button", IDC_KNOPOK, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 292, 192, 29, 21
 CONTROL "Button", IDC_KNOPCLEAR, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 348, 192, 29, 21
